<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: setup-runner.sh fills in the __PLACEHOLDERS__ and installs it
     into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.horizontalsystems.e2e.maintenance</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SCRIPTS__/maintenance.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>ANDROID_HOME</key>
        <string>__ANDROID_HOME__</string>
        <key>JAVA_HOME</key>
        <string>__JAVA_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__E2E_HOME__/logs/maintenance.log</string>
    <key>StandardErrorPath</key>
    <string>__E2E_HOME__/logs/maintenance.log</string>
</dict>
</plist>
