# Local settings for running the Maestro tests on your machine. Copy this file
# to maestro/.env.e2e, fill in the values and keep it private:
#   cp maestro/.env.example maestro/.env.e2e && chmod 600 maestro/.env.e2e
# .env.e2e is gitignored. Never put values in this example file.
#
# Format: KEY=value, one per line, no spaces around "=". Quotes are optional.
# A variable already set in your environment takes precedence. Empty values
# are ignored. GitHub Actions reads the same values from repository secrets
# (see maestro/README.md, Secrets).

# Recovery phrase of the team dust wallet, used by the on-chain tests.
# Variables starting with MAESTRO_ reach the flows without -e.
MAESTRO_E2E_DUST_MNEMONIC=

# Telegram bot that reports runs, for trying notify-telegram.sh locally. The
# chat id is the group or user to post to.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Screen lock PIN device-prepare.sh sets on the emulators (default: 1111).
E2E_DEVICE_PIN=
