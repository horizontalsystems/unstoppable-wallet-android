# Variables the Maestro flows read from the environment. Names only: never
# commit values. On the runner Mac the values live in the Keychain; locally,
# copy this to maestro/.env.e2e (gitignored), fill it in and run
#   set -a; source maestro/.env.e2e; set +a
# before maestro. Variables prefixed MAESTRO_ reach the flows without -e, so
# secrets stay out of process arguments.

# Recovery phrase of the team dust wallet (onchain/ tests)
MAESTRO_E2E_DUST_MNEMONIC=
